{
  "name": "mrp-consultar-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host --port 5173",
    "dev:react": "vite --host --port 5173",
    "electron:dev": "wait-on http://localhost:5173 && electron .",
    "electron:prod": "npm run build:electron && set \"ELECTRON_LOAD_FILE=true\" && electron .",
    "dev:desktop": "concurrently -k \"npm:dev:react\" \"npm:electron:dev\"",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:electron": "set \"VITE_ELECTRON=true\" && tsc -b && vite build",
    "desktop:build": "npm run build:electron && electron-builder --config electron-builder.config.cjs",
    "desktop:win": "npm run build:electron && electron-builder --config electron-builder.config.cjs --win",
    "desktop:linux": "npm run build:electron && electron-builder --config electron-builder.config.cjs --linux",
    "desktop:mac": "npm run build:electron && electron-builder --config electron-builder.config.cjs --mac",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@mui/x-data-grid": "^8.1.0",
    "@mui/x-date-pickers": "^8.8.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.8.4",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.6.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "motion": "^12.6.2",
    "papaparse": "^5.5.2",
    "pptxgenjs": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-is": "^19.1.0",
    "react-router": "^7.4.0",
    "react-router-dom": "^7.4.0",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.0.5",
    "react-use": "^17.6.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.0.0",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.7",
    "styled-components": "^6.1.16",
    "victory": "^37.3.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/jspdf": "^1.3.3",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.0",
    "wait-on": "^9.0.10"
  }
}
